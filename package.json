{
  "name": "prorab-salon",
  "private": true,
  "version": "1.0.0",
  "description": "Салон отделочных материалов ПРОРАБ — Ростовская область",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:zip": "npm run build && \"%SystemRoot%/System32/tar.exe\" -a -c -f build-timeweb.zip -C dist .",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "vite": "^6.3.5"
  }
}
